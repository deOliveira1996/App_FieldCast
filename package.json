{
  "name": "fieldcast",
  "private": true,
  "version": "4.3.0",
  "type": "module",
  "description": "FieldCast — Plataforma open-source de previsão meteorológica, oceanográfica e apoio à decisão em campo (PWA & Android Capacitor)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build",
    "desktop:prepare": "powershell -ExecutionPolicy Bypass -File scripts/package-desktop.ps1",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "icons:generate": "node scripts/generate-icons.mjs",
    "cap:sync": "npx cap sync",
    "cap:android": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/camera": "^6.1.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.2",
    "@capacitor/geolocation": "^6.1.0",
    "@capacitor/share": "^6.0.2",
    "dexie": "^4.0.10",
    "echarts": "^5.6.0",
    "echarts-for-react": "^3.0.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "suncalc": "^1.9.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.2.0",
    "@types/leaflet": "^1.9.14",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/suncalc": "^1.9.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/ui": "^2.1.8",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.2",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8"
  }
}
