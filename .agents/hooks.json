{
  "fieldcast-security-gate": {
    "PreToolUse": [
      {
        "matcher": "run_command|write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": ".\\scripts\\safety-gate.cmd",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": ".\\scripts\\safety-gate.cmd",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
